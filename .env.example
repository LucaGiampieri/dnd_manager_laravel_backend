#Configurazione generale dell'applicazione
APP_NAME="DnD Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

#Lingua utilizzata dall'applicazione
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

#Modalità di manutenzione
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

#Numero di processi del server PHP integrato
# PHP_CLI_SERVER_WORKERS=4

#Costo utilizzato per la cifratura delle password
BCRYPT_ROUNDS=12

#Configurazione dei log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#Configurazione del database MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dnd_manager
DB_USERNAME=root
DB_PASSWORD=

#Configurazione delle sessioni
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

#Domini del frontend autorizzati a utilizzare Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

#Servizi utilizzati dall'applicazione
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

#Configurazione di Memcached
MEMCACHED_HOST=127.0.0.1

#Configurazione di Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#Configurazione dell'invio delle email
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#Configurazione facoltativa di Amazon S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#Nome dell'applicazione disponibile nel frontend Vite
VITE_APP_NAME="${APP_NAME}"